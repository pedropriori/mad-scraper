LOGIN_EMAIL=seu@email.com
LOGIN_PASSWORD=sua_senha
OUTPUT_DIR=mentoria-american-dream

# Browser: false = janela visível, true = janela fora da tela (invisível mas não headless)
# NOTA: headless=true do Chromium é detectado pelo site e impede captura de Anexos.
#       O scraper sempre roda em modo não-headless; HEADLESS só controla visibilidade da janela.
AUTH_HEADLESS=false   # browser abre só durante o login (~5s)
HEADLESS=true         # scraping: true = janela fora da tela, false = janela visível

# Velocidade de download — perfis: eco | normal | fast | ultra
# eco=4 (~20 Mbps)  normal=16 (~76 Mbps)  fast=32 (~222 Mbps)  ultra=64 (experimental)
CONCURRENT_FRAGMENTS=32
